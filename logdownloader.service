[Unit]
Description=LogDownloader - VictoriaLogs Export Tool
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/logdownloader
# Env YAML'dan ustun turadi — shu yerda PORT/DATA_DIR bermaymiz, aks holda
# /etc/logdownloader/config.yaml dagi qiymatlar e'tiborga olinmaydi.
WorkingDirectory=/var/lib/logdownloader
Restart=on-failure
RestartSec=5
User=logdownloader
Group=logdownloader

[Install]
WantedBy=multi-user.target
